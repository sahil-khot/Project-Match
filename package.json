{
  "name": "project-match",
  "version": "1.0.0",
  "description": "Project Match - Where Ideas Find the Right Team",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "node -e \"const fs=require('fs'),cp=require('child_process'); if(fs.existsSync('./client/package.json')) cp.execSync('npm run build --prefix client', {stdio:'inherit'}); else cp.execSync('npx vite build', {stdio:'inherit'});\"",
    "start": "node server/src/server.js"
  },
  "allowScripts": {
    "@google/genai": true,
    "protobufjs": true,
    "esbuild": true
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.3",
    "@rollup/rollup-linux-x64-musl": "4.63.3"
  }
}
